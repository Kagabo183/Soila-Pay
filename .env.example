APP_ENV=local
LOG_LEVEL=INFO

# Apache Fineract - kept for a planned future flow; nothing uses it today.
FINERACT_BASE_URL=https://localhost:8443/fineract-provider/api/v1
FINERACT_TENANT_ID=default
FINERACT_USERNAME=mifos
FINERACT_PASSWORD=password
# Fineract ships with a self-signed cert out of the box. false = skip TLS
# verification. LOCAL-DEV ONLY - set true (with a real CA-signed cert) in prod.
FINERACT_SSL_VERIFY=false
# Placeholder - must match a real payment type id configured on your Fineract tenant.
FINERACT_PAYMENT_TYPE_ID=1
FINERACT_LOCALE=en
FINERACT_DATE_FORMAT=dd MMMM yyyy
FINERACT_TIMEOUT_SECONDS=15

# LMBTech payment gateway - collections (cards via Pesapal's hosted page, plus
# MTN MoMo) and disbursements (payouts to MTN MoMo). Keys are on your LMBTech profile page
# ("API Credentials"). Real keys go in .env only - never commit them.
LMBTECH_BASE_URL=https://pay.lmbtech.rw/pay/config/api.php
LMBTECH_APP_KEY=your-lmbtech-app-key
LMBTECH_SECRET_KEY=your-lmbtech-secret-key
# Your LMBTech account email - required for payouts (disbursements).
LMBTECH_ACCOUNT_EMAIL=you@example.com
# true while your LMBTech account is in Test Mode - payments are labelled TEST.
LMBTECH_TEST_MODE=true
# Public URL of this API - LMBTech posts payment callbacks to
# {PUBLIC_API_BASE_URL}/api/v1/payments/callback/lmbtech. With localhost the
# callback can't arrive; the app polls LMBTech instead, so it still works.
PUBLIC_API_BASE_URL=http://localhost:8000
# Public URL of the web app - card payers return to {FRONTEND_BASE_URL}/pay/return.
FRONTEND_BASE_URL=http://localhost:3000

# Signs integrator self-service portal session tokens (app/api/v1/integrator_portal.py,
# app/services/integrator_auth.py). MUST be overridden with a real random
# value for any shared/production deployment - main.py warns loudly at
# startup if the insecure default is still set while APP_ENV=prod.
INTEGRATOR_SESSION_SECRET=your-long-random-integrator-session-secret

# Operator/admin login for /api/v1/admin/* (integrators, pricing, collections,
# payouts) - a single shared credential, not a per-admin user table.
# Left blank means admin auth fails CLOSED (nobody can log in), not open with
# a guessable default - you must set both to use the admin console.
ADMIN_USERNAME=your-admin-username
ADMIN_PASSWORD=your-admin-password
ADMIN_SESSION_SECRET=your-long-random-admin-session-secret

# MySQL 8 (local install or hosted). `python scripts/init_db.py` creates the
# database + MYSQL_USER and applies db_init/*.sql. MYSQL_ROOT_PASSWORD is only
# used by that script; leave it empty if the DB/user already exist (hosted MySQL).
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=soila_pay
MYSQL_USER=soila_app
MYSQL_PASSWORD=changeme
MYSQL_ROOT_PASSWORD=changeme_root
