APP_ENV=local
LOG_LEVEL=INFO

# Fineract now runs as its own "fineract-core" service in docker-compose.yml,
# reachable by its service name over the compose network. If you instead run
# Fineract on your HOST machine (outside this compose stack), point this at
# https://host.docker.internal:8443/fineract-provider/api/v1 instead - "localhost"
# inside the middleware container refers to the container itself, not your host.
FINERACT_BASE_URL=https://fineract-core:8443/fineract-provider/api/v1
FINERACT_TENANT_ID=default
FINERACT_USERNAME=mifos
FINERACT_PASSWORD=password
# Fineract ships with a self-signed cert out of the box. false = skip TLS
# verification. LOCAL-DEV ONLY - set true (with a real CA-signed cert) in prod.
FINERACT_SSL_VERIFY=false
# Placeholder - must match a real payment type id configured on your Fineract tenant.
FINERACT_PAYMENT_TYPE_ID=1
FINERACT_LOCALE=en
FINERACT_DATE_FORMAT=dd MMMM yyyy
FINERACT_TIMEOUT_SECONDS=15

COLLECTION_PROVIDER_NAME=ddin
COLLECTION_DUMMY_BASE_URL=http://dummy-collection:9000
COLLECTION_TIMEOUT_SECONDS=10
COLLECTION_DUMMY_LATENCY_SECONDS=0.2

# DDIN / Moola credentials (Auth & Accounts + Collection API). DDIN issues
# separate sandbox vs production credentials and likely a different base URL
# for each - swap all three of these when moving from testing to production,
# nothing in app/ code needs to change.
DDIN_BASE_URL=https://agenttestapi.ddin.rw
DDIN_USERNAME=your-ddin-sandbox-username
DDIN_PASSWORD=your-ddin-sandbox-password
DDIN_LOGIN_PATH=/v1/agency/auth/login
DDIN_REFRESH_PATH=/v1/agency/auth/refresh-token
# ASSUMPTION - only the base-URL example path was documented, not the actual
# Collection API section. Confirm/correct against DDIN's real docs.
DDIN_COLLECTION_PATH=/v1/momo/collection/initiate
DDIN_TIMEOUT_SECONDS=15
# Issued when you register a webhook subscription with DDIN (separate from
# DDIN_USERNAME/PASSWORD) - verifies X-Moola-Signature on incoming
# collection.success/collection.failed webhooks. See app/api/v1/webhooks.py.
# Leave unset only for local dev without real webhook traffic - an empty
# secret means verify_ddin_signature() always rejects incoming webhooks.
DDIN_WEBHOOK_SECRET=your-ddin-webhook-secret

REFUND_MAX_ATTEMPTS=5
REFUND_BACKOFF_BASE_SECONDS=1.0

# Retries transient DDIN failures (timeouts, connection errors, 5xx) with
# exponential backoff - never retries 401/403 or other 4xx. See
# app/services/collection_provider.py.
DDIN_RETRY_MAX_ATTEMPTS=3
DDIN_RETRY_BACKOFF_BASE_SECONDS=0.5

# Signs integrator self-service portal session tokens (app/api/v1/integrator_portal.py,
# app/services/integrator_auth.py). MUST be overridden with a real random
# value for any shared/production deployment - main.py warns loudly at
# startup if the insecure default is still set while APP_ENV=prod.
INTEGRATOR_SESSION_SECRET=your-long-random-integrator-session-secret

# Operator/admin login for /api/v1/admin/* (integrator CRUD, DDIN diagnostics,
# revenue summary) - a single shared credential, not a per-admin user table.
# Left blank means admin auth fails CLOSED (nobody can log in), not open with
# a guessable default - you must set both to use the admin console.
ADMIN_USERNAME=your-admin-username
ADMIN_PASSWORD=your-admin-password
ADMIN_SESSION_SECRET=your-long-random-admin-session-secret

# Max diagnostics runs per minute across all callers (in-memory, per-process -
# see the "Known gap" note in README if this ever runs behind multiple
# replicas). Protects DDIN's sandbox from being hammered by mistake.
DDIN_DIAGNOSTICS_RATE_LIMIT_PER_MINUTE=10

# MYSQL_HOST is overridden to "mysql" by docker-compose.yml when run via compose.
# MYSQL_PORT is the container-internal port (always 3306) - the host-side mapping
# in docker-compose.yml (3307:3306) is only for connecting a MySQL client from your
# host machine, and does not affect this value.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=soila_pay
MYSQL_USER=soila_app
MYSQL_PASSWORD=changeme
MYSQL_ROOT_PASSWORD=changeme_root

# Password for fineract-db (Postgres) in docker-compose.yml - a separate database
# used only by fineract-core, not read by this app directly.
FINERACT_DB_PASSWORD=changeme_fineract_db
