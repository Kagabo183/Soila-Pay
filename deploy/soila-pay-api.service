# systemd unit for the FastAPI backend.
# Install: cp deploy/soila-pay-api.service /etc/systemd/system/
#          systemctl daemon-reload && systemctl enable --now soila-pay-api
[Unit]
Description=Soila-Pay API (FastAPI)
After=network.target mysql.service

[Service]
Type=simple
User=www-data
WorkingDirectory=/var/www/soila-pay
EnvironmentFile=/var/www/soila-pay/.env
ExecStart=/var/www/soila-pay/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 1
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
