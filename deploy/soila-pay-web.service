# systemd unit for the Next.js frontend (run `npm ci && npm run build` first).
# Install: cp deploy/soila-pay-web.service /etc/systemd/system/
#          systemctl daemon-reload && systemctl enable --now soila-pay-web
[Unit]
Description=Soila-Pay web (Next.js)
After=network.target soila-pay-api.service

[Service]
Type=simple
User=www-data
WorkingDirectory=/var/www/soila-pay/frontend
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=HOSTNAME=127.0.0.1
ExecStart=/usr/bin/npm start
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
